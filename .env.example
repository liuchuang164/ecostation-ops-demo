# 默认：在线OpenStreetMap瓦片；加载失败时显示本地OSM地理简图
VITE_BASEMAP_MODE=online
# 离线汇报可改为local：无需网络，使用杭州西部OSM简化GeoJSON
# VITE_BASEMAP_MODE=local
# 可替换兼容EPSG:3857且使用WGS84基准的XYZ服务，重启Vite生效
# VITE_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# 更换服务时请填写该服务要求的来源标注。需要密钥的服务只在本地.env.local配置
# VITE_BASEMAP_ATTRIBUTION='© OpenStreetMap contributors'
